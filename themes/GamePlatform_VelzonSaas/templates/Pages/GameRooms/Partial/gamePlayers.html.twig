{% for team in gameTeams %}
    {% for player in team %}
        {% if player.photoUrl %}
            {% set photoUrl = player.photoUrl %}
        {% else %}
            {% if player.avatarPath %}
                {% set photoUrl = player.avatarPath | imagine_filter( 'users_crud_index_thumb' ) %}
            {% else %}
                {% set photoUrl = '' %}
            {% endif %}
        {% endif %}
        
        <div rel="0" class="dib">
            <img class="tip" height="46" src="{{ photoUrl }}">
        </div>
    {% endfor %}
    
    {% if not loop.last %}
        <div class="dib vs">VS</div>
    {% endif %}
{% endfor %}