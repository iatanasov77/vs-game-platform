<div id="add-game-room-player-modal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    Add Game Room Player
				</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"> </button>
            </div>
            <div class="modal-body">
            
                <div id="modalBodyAddGameRoomPlayer" class="card alert mb-2">
                    <div class="card-body" id="AddGameRoomFormPlayerContainer"></div>
                </div>
                
            </div>
            
            <div class="modal-footer" id="imContainer">
                <button type="button" class="btn btn-primary" id="btnSaveGameRoomPlayer">
                    {{ 'vs_application.form.save' | trans( {},'VSApplicationBundle' ) }}
                </button>
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">
                    {{ 'vs_application.form.close' | trans( {},'VSApplicationBundle' ) }}
				</button>
            </div>
        </div>
    </div>
</div>
