{% extends "base.html.twig" %}

{% block content %}
    <div class="card">
        <div class="card-header align-items-center d-flex">
            <h4 class="card-title mb-0 flex-grow-1">
                Game Sessions
            </h4>
            
            <div class="flex-shrink-0">
                <button id="CreateGameRoom" class="btn btn-block btn-primary btn-xl"
                    data-url="{{ path( 'app_create_game_room_form' ) }}"
                >
                    Create Game Room
                </button>
                <button id="ClearGameSessions" class="btn btn-block btn-primary btn-xl"
                    data-url="{{ path( 'app_clear_game_room_sessions_form' ) }}"
                >
                    Clear Game Sessions
                </button>
            </div>
        </div><!-- end card header -->

        <div class="card-body">
            <div class="table-responsive">
                
                <!-- Striped Rows -->
                <table class="table table-striped game-rooms-table">
                    <thead>
                        <tr>
                            <th scope="col"></th>
                            <th scope="col">Owner</th>
                            <th scope="col">Guid</th>
                            <th scope="col">Game</th>
                            <th scope="col">Players Addition</th>
                            <th scope="col">Players</th>
                            <th scope="col">Status</th>
                            <th scope="col">Updated At</th>
                            <th scope="col">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for room in gameRooms %}
                            <tr>
                                <th scope="row">{{ loop.index }}</th>
                                <td>{{ room.owner.name }}</td>
                                <td>
                                    <span
                                        data-bs-toggle="tooltip"
                                        data-bs-placement="top"
                                        data-bs-html="true"
                                        title="<b>{{ room.guid }}</b>"
                                    >
                                        {{ room.guid | u.truncate( 15, ' ...' ) }}
                                    </span>
                                </td>
                                <td>{{ room.game.title }}</td>
                                <td>{{ room.gamePlayers | length }} / {{ room.game.maxPlayers }}</td>
                                <td>
                                    <div class="cell-players observers">
                                        {% for team in gameRoomTeams[room.id] %}
                                            {% for player in team %}
                                                <div rel="0" class="player-slot dib">
                                                    {{ player.photoUrlImage | raw }}
                                                </div>
                                            {% endfor %}
                                            
                                            {% if not loop.last %}
                                                <div class="dib vs">VS</div>
                                            {% endif %}
                                        {% endfor %}
                                    </div>
                                </td>
                                <td>{{ room.status }}</td>
                                <td>{{ room.updatedAt | date( 'd M Y' ) }}</td>
                                <td>
                                    <div class="dropdown">
                                        <a href="javascript:void(0);" class="btn btn-light btn-icon" id="dropdownMenuLink15"
                                            data-bs-toggle="dropdown"
                                            aria-expanded="true"
                                            title="Show Actions"
                                        >
                                            <i class="ri-equalizer-fill"></i>
                                        </a>
                                        
                                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="dropdownMenuLink15">
                                            {% if app.user in room.users %}
                                                <li>
                                                    <a class="dropdown-item btn btn-primary btnLeaveGameRoom"
                                                        data-url="{{ path( 'app_leave_game_room', {'roomId': room.id} ) }}"
                                                        title="Leave Room"
                                                    >
                                                        <i class="fa-solid fa-right-from-bracket me-2 align-middle text-muted"></i>
                                                        Leave Room
                                                    </a>
                                                </li>
                                            {% endif %}
                                            
                                            {% if app.user not in room.users and room.gamePlayers | length < room.game.maxPlayers %}
                                                <li>
                                                    <a class="dropdown-item btn btn-primary btnJoinGameRoom"
                                                        data-url="{{ path( 'app_join_game_room', {'roomId': room.id} ) }}"
                                                        title="Join Room"
                                                    >
                                                        <i class="fa-solid fa-right-to-bracket me-2 align-middle text-muted"></i>
                                                        Join Room
                                                    </a>
                                                </li>
                                            {% endif %}
                                            
                                            {% if room.gamePlayers | length < room.game.maxPlayers %}
                                                <li>
                                                    <a class="dropdown-item btn btn-primary btnAddPlayer"
                                                        data-url="{{ path( 'app_add_user_into_game_room_form', {'roomId': room.id} ) }}"
                                                        title="Add Player"
                                                    >
                                                        <i class="fa-solid fa-user-plus me-2 align-middle text-muted"></i>
                                                        Add Player
                                                    </a>
                                                </li>
                                            {% endif %}
                                            
                                            <li>
                                                <a class="dropdown-item btn btn-danger btnDeleteGameRoom"
                                                    data-url="{{ path( 'app_delete_game_room', {'id': room.id} ) }}"
                                                    title="{{ 'vs_application.template.items_index_row_action_delete' | trans( {},'VSApplicationBundle' ) }}"
                                                >
                                                    <i class="icon_close_alt2 me-2 align-middle text-muted"></i>
                                                    {{ 'vs_application.template.items_index_row_action_delete' | trans( {},'VSApplicationBundle' ) }}
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
                
            </div>
        </div>
    </div>
    
    {% include 'Layout/pagination_container.html.twig' with {'items': gameRooms} %}
{% endblock %}

{% block modals %}
    {% include 'Modal/createGameRoom.html.twig' %}
    {% include 'Modal/clearGameSessions.html.twig' %}
    {% include 'Modal/addGameRoomPlayer.html.twig' %}
{% endblock %}

{% block head_styles %}
    {{ parent() }}
    
    {{ encore_entry_link_tags( 'js/game-rooms', null, 'GameplatformVelzonsaasTheme' ) }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    
    {{ encore_entry_script_tags( 'js/game-rooms', null, 'GameplatformVelzonsaasTheme' ) }}
{% endblock %}
